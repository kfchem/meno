{
  "id": "lumen",
  "name": "Lumen",
  "version": "0.5.0",
  "description": "Renders pictures and films of molecules with Lumen, a made-up renderer it fetches.",
  "licence": "GPL-3.0-or-later",
  "homepage": "https://example.org/lumen",
  "environment": "uv",
  "systems": [
    "macos",
    "windows"
  ],
  "downloads": [
    {
      "file": "lumen-4.1-macos-arm64.dmg",
      "name": "Lumen 4.1",
      "licence": "MIT",
      "url": "https://downloads.example.org/lumen/4.1/lumen-4.1-macos-arm64.dmg",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "bytes": 300000000,
      "system": "macos",
      "arch": "aarch64",
      "unpack": "dmg",
      "program": "Lumen.app/Contents/MacOS/Lumen",
      "provides": "lumen"
    },
    {
      "file": "lumen-4.1-windows-x64.zip",
      "name": "Lumen 4.1",
      "licence": "MIT",
      "url": "https://downloads.example.org/lumen/4.1/lumen-4.1-windows-x64.zip",
      "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "bytes": 350000000,
      "system": "windows",
      "arch": "x86_64",
      "unpack": "zip",
      "program": "*/lumen.exe",
      "provides": "lumen"
    },
    {
      "file": "lumen-4.1-windows-arm64.zip",
      "name": "Lumen 4.1",
      "licence": "MIT",
      "url": "https://downloads.example.org/lumen/4.1/lumen-4.1-windows-arm64.zip",
      "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "bytes": 250000000,
      "system": "windows",
      "arch": "aarch64",
      "unpack": "zip",
      "program": "*/lumen.exe",
      "provides": "lumen"
    }
  ],
  "steps": [
    {
      "kinds": [
        "render"
      ],
      "programs": [
        "lumen"
      ]
    }
  ],
  "interfaces": [
    {
      "id": "preset",
      "version": "1.0.0"
    }
  ],
  "roles": [
    {
      "role": "render",
      "programs": [
        "lumen"
      ],
      "options": [
        {
          "id": "engine",
          "label": "Renderer",
          "type": "choice",
          "choices": [
            {
              "value": "traced",
              "label": "Light traced"
            },
            {
              "value": "fast",
              "label": "Drawn in real time"
            }
          ],
          "default": "traced",
          "section": "render",
          "when": {
            "id": "shading",
            "in": [
              "lit"
            ]
          }
        },
        {
          "id": "samples",
          "label": "Samples for each pixel",
          "type": "number",
          "default": 128,
          "min": 1,
          "max": 4096,
          "step": 1,
          "section": "render"
        },
        {
          "id": "denoise",
          "label": "Remove noise",
          "type": "switch",
          "default": true,
          "section": "render",
          "when": {
            "id": "shading",
            "in": [
              "lit"
            ]
          }
        },
        {
          "id": "device",
          "label": "Render on",
          "type": "choice",
          "choices": [
            {
              "value": "auto",
              "label": "Automatic"
            },
            {
              "value": "gpu",
              "label": "Graphics processor"
            },
            {
              "value": "cpu",
              "label": "Processor"
            }
          ],
          "default": "auto",
          "section": "render"
        },
        {
          "id": "background",
          "label": "Background",
          "type": "choice",
          "choices": [
            {
              "value": "transparent",
              "label": "Transparent"
            },
            {
              "value": "white",
              "label": "White"
            },
            {
              "value": "black",
              "label": "Black"
            },
            {
              "value": "grey",
              "label": "Grey"
            }
          ],
          "default": "transparent",
          "section": "scene"
        },
        {
          "id": "colours",
          "label": "Colours",
          "type": "choice",
          "choices": [
            {
              "value": "neutral",
              "label": "True to the style"
            },
            {
              "value": "filmic",
              "label": "Film-like"
            }
          ],
          "default": "neutral",
          "section": "render"
        },
        {
          "id": "key",
          "label": "Key light, against the canvas's",
          "type": "number",
          "default": 1,
          "min": 0,
          "max": 10,
          "step": 0.1,
          "unit": "×",
          "section": "scene"
        },
        {
          "id": "ambient",
          "label": "Light all round, against the canvas's",
          "type": "number",
          "default": 1,
          "min": 0,
          "max": 10,
          "step": 0.1,
          "unit": "×",
          "section": "scene"
        },
        {
          "id": "softness",
          "label": "Shadows' softness",
          "type": "number",
          "default": 10,
          "min": 0,
          "max": 90,
          "step": 1,
          "unit": "°",
          "section": "scene"
        },
        {
          "id": "quality",
          "label": "Quality",
          "type": "choice",
          "choices": [
            {
              "value": "high",
              "label": "High"
            },
            {
              "value": "medium",
              "label": "Medium: smaller"
            }
          ],
          "default": "high",
          "section": "render",
          "when": {
            "id": "kind",
            "in": [
              "film"
            ]
          }
        }
      ]
    }
  ]
}
