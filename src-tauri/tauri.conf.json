{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meno",
  "version": "../package.json",
  "identifier": "com.kfchem.meno",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meno",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "script-src": "'self' blob: 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "font-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: ws://localhost:1421 http://localhost:1420",
        "script-src": "'self' blob: 'unsafe-inline' 'unsafe-eval' http://localhost:1420",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "font-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "capabilities": ["default", "main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/kfchem/meno/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2MjUxNjIxMTk0QkY2RjIKUldUeTlrc1pJUllsRmtVZjNaQktEM3c4eEdOVWFlc0F3NjN5NEpadnZ4QUVYcFAwT2RSTEdOWGYK",
      "requireSignedVersion": true,
      "windows": { "installMode": "quiet" }
    }
  }
}
