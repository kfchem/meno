{
  "id": "pyscf",
  "name": "PySCF",
  "version": "0.2.0",
  "uses": [{"name": "PySCF", "version": "2.14.0"}],
  "description": "Works out orbitals and densities on a grid, from a Molden file.",
  "licence": "Apache-2.0",
  "homepage": "https://pyscf.org",
  "environment": "pixi",
  "kinds": [
    {"id": "molden", "name": "Molden file", "extensions": [".molden", ".mld"], "marks": [{"text": "[Molden Format]", "at": "line-start", "anyCase": true}]}
  ],
  "reads": ["molden"]
}
