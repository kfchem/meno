{
  "id": "blender",
  "name": "Blender",
  "version": "0.6.6",
  "uses": [{"name": "Blender", "version": "5.2.2"}],
  "description": "Renders pictures and films of molecules in 3D with Blender 5.2.2 LTS - its official build, under its own licence, fetched by Meno as the plugin is set up and kept for Meno's own use.",
  "licence": "GPL-3.0-or-later",
  "homepage": "https://www.blender.org",
  "environment": "uv",
  "systems": ["macos", "windows"],
  "downloads": [
    {"file": "blender-5.2.2-macos-arm64.dmg", "name": "Blender 5.2.2 LTS", "licence": "GPL-3.0-or-later", "url": "https://download.blender.org/release/Blender5.2/blender-5.2.2-macos-arm64.dmg", "sha256": "dc4125399b8bfefe283cc1624d6cfc7809d1cac20ace51072127eb371f31f210", "bytes": 346286611, "system": "macos", "arch": "aarch64", "unpack": "dmg", "program": "Blender.app/Contents/MacOS/Blender", "provides": "blender"},
    {"file": "blender-5.2.2-windows-x64.zip", "name": "Blender 5.2.2 LTS", "licence": "GPL-3.0-or-later", "url": "https://download.blender.org/release/Blender5.2/blender-5.2.2-windows-x64.zip", "sha256": "3849d17a682cba006075aaa3f3597ecb5c9c30ec31035b2e092c53e40679b535", "bytes": 404453484, "system": "windows", "arch": "x86_64", "unpack": "zip", "program": "*/blender.exe", "provides": "blender"},
    {"file": "blender-5.2.2-windows-arm64.zip", "name": "Blender 5.2.2 LTS", "licence": "GPL-3.0-or-later", "url": "https://download.blender.org/release/Blender5.2/blender-5.2.2-windows-arm64.zip", "sha256": "2e90b53c9443cc56d2be75a61550a38e4aba942c8cded046ceff98ed58ebc67b", "bytes": 274036892, "system": "windows", "arch": "aarch64", "unpack": "zip", "program": "*/blender.exe", "provides": "blender"}
  ],
  "steps": [
    {"kinds": ["render"], "programs": ["blender"]}
  ],
  "roles": [
    {
      "role": "render",
      "programs": ["blender"],
      "looks": [
        {"id": "clay", "label": "Terracotta: unglazed, one colour or the elements'", "description": "Unglazed fired clay in a studio's light: terracotta, or each element its colour.", "own": true, "parts": {"molecules": "clay", "surfaces": "matte"}},
        {"id": "gold", "label": "Gold: polished metal", "description": "Polished gold in a studio's light.", "own": true},
        {"id": "silver", "label": "Silver: mirror or satin", "description": "Silver, mirror or satin.", "own": true},
        {"id": "copper", "label": "Copper: brushed or tarnished", "description": "Copper, brushed or tarnished.", "own": true},
        {"id": "bubble", "label": "Soap bubble: clear, with thin-film colour", "description": "Clear, with a thin film's colours at the rim.", "parts": {"sticks": "stopped"}, "own": true, "seeThrough": true},
        {"id": "wood", "label": "Wood: varnished, in a species", "description": "Varnished wood: oak, walnut, cherry, maple, ebony, or by element.", "own": true},
        {"id": "marble", "label": "Marble: polished white stone, veined", "description": "Polished white stone with veins.", "own": true},
        {"id": "porcelain", "label": "Porcelain: glazed blue-white", "description": "Glazed porcelain, or a pearl's cream white.", "own": true},
        {"id": "slime", "label": "Slime: see-through jelly", "description": "A see-through jelly in the element colours.", "parts": {"sticks": "stopped"}, "own": true, "seeThrough": true},
        {"id": "neon", "label": "Neon: lit tubes", "description": "Lit tubes that glow at their edges.", "own": true},
        {"id": "xray", "label": "X-ray: layers that add up", "description": "See-through layers that add up.", "parts": {"sticks": "shown"}, "own": true, "seeThrough": true},
        {"id": "fur", "label": "Fur: long, or short and dense as velvet", "description": "Hair on every ball and stick.", "own": true}
      ],
      "motions": [
        {"id": "reveal", "label": "Reveal: out of the dark, or developing on white", "description": "A rim of light traces the molecule, then the key light comes up; on white, a pale form develops into colour.", "shortest": {"film": 4, "loop": 6}, "fixed": [{"id": "engine", "value": "cycles", "why": "This motion is made with light traced"}]},
        {"id": "pulse", "label": "Pulse: a wave along the bonds", "description": "A wave of light runs out along the bonds; on white, a cobalt wave throwing blue light onto the paper.", "shortest": {"film": 3}, "fixed": [{"id": "engine", "value": "cycles", "why": "This motion is made with light traced"}]},
        {"id": "assemble", "label": "Assemble: atoms fly in, bonds drawn", "description": "The atoms fly in on curves and land in waves from the middle; each bond is drawn by a bright front.", "shortest": {"film": 5, "loop": 7}, "fixed": [{"id": "engine", "value": "cycles", "why": "This motion is made with light traced"}]},
        {"id": "scan", "label": "Scan: a sheet of light, a hologram above it", "description": "A sheet of light passes down the molecule: a hologram above it, the solid below.", "shortest": {"film": 5}, "fixed": [{"id": "engine", "value": "cycles", "why": "This motion is made with light traced"}]},
        {"id": "dissolve", "label": "Dissolve: burning away into embers", "description": "The molecule burns away from one side into embers; on white, amber grains cooling to graphite dust.", "shortest": {"film": 4, "loop": 7}, "fixed": [{"id": "engine", "value": "cycles", "why": "This motion is made with light traced"}]},
        {"id": "change-ring", "label": "Change, ring: atoms circle and land as the next", "description": "Two molecules or more, one becoming the next in turn: the atoms rise into one ring, which turns and lets them fall into the next molecule's places.", "shortest": {"change": 3}, "fixed": [{"id": "engine", "value": "cycles", "why": "This motion is made with light traced"}]},
        {"id": "change-scan", "label": "Change, scan: a sheet of light leaves the next", "description": "Two molecules or more, one becoming the next in turn: a sheet of light passes down through the molecule, and leaves the next one above it.", "shortest": {"change": 3}, "fixed": [{"id": "engine", "value": "cycles", "why": "This motion is made with light traced"}]},
        {"id": "change-shatter", "label": "Change, shatter: shards gather into the next", "description": "Two molecules or more, one becoming the next in turn: the molecule shatters, and its shards fly together into the next one.", "shortest": {"change": 3}, "fixed": [{"id": "engine", "value": "cycles", "why": "This motion is made with light traced"}]}
      ],
      "options": [
        {"id": "pile", "section": "look", "when": {"id": "look", "in": ["fur"]}, "label": "Pile", "type": "choice", "choices": [{"value": "long", "label": "Long: fur"}, {"value": "short", "label": "Short and dense: velvet"}], "default": "long"},
        {"id": "clay-colour", "section": "look", "when": {"id": "look", "in": ["clay"]}, "label": "Terracotta's colour", "type": "choice", "choices": [{"value": "terracotta", "label": "One colour (terracotta)"}, {"value": "elements", "label": "Element colours"}], "default": "terracotta"},
        {"id": "porcelain-finish", "section": "look", "when": {"id": "look", "in": ["porcelain"]}, "label": "Porcelain's finish", "type": "choice", "choices": [{"value": "porcelain", "label": "Porcelain: glazed blue-white"}, {"value": "pearl", "label": "Pearl: cream white with an orient"}], "default": "porcelain"},
        {"id": "silver-finish", "section": "look", "when": {"id": "look", "in": ["silver"]}, "label": "Silver's finish", "type": "choice", "choices": [{"value": "mirror", "label": "Mirror"}, {"value": "satin", "label": "Satin"}], "default": "mirror"},
        {"id": "copper-finish", "section": "look", "when": {"id": "look", "in": ["copper"]}, "label": "Copper's finish", "type": "choice", "choices": [{"value": "brushed", "label": "Brushed"}, {"value": "tarnished", "label": "Tarnished"}], "default": "brushed"},
        {"id": "wood", "section": "look", "when": {"id": "look", "in": ["wood"]}, "label": "Wood", "type": "choice", "choices": [{"value": "oak", "label": "Oak"}, {"value": "walnut", "label": "Walnut"}, {"value": "cherry", "label": "Cherry"}, {"value": "maple", "label": "Maple"}, {"value": "ebony", "label": "Ebony"}, {"value": "element", "label": "By element: each its own wood"}], "default": "oak"},
        {"id": "marble", "section": "look", "when": {"id": "look", "in": ["marble"]}, "label": "Marble's pattern", "type": "choice", "choices": [{"value": "carrara", "label": "Carrara: long veins across the molecule"}, {"value": "swirl", "label": "Swirls on each atom"}], "default": "carrara"},
        {"id": "engine", "section": "render", "when": {"id": "shading", "in": ["lit"]}, "label": "Renderer", "type": "choice", "choices": [{"value": "cycles", "label": "Cycles: light traced"}, {"value": "eevee", "label": "EEVEE: drawn in real time"}], "default": "cycles"},
        {"id": "samples", "section": "render", "label": "Samples for each pixel", "type": "number", "default": 128, "min": 1, "max": 4096, "step": 1},
        {"id": "denoise", "section": "render", "when": {"id": "shading", "in": ["lit"]}, "label": "Remove noise", "type": "switch", "default": true},
        {"id": "device", "section": "render", "label": "Render on", "type": "choice", "choices": [{"value": "auto", "label": "Automatic (the faster one)"}, {"value": "gpu", "label": "Graphics processor"}, {"value": "cpu", "label": "Processor"}], "default": "auto"},
        {"id": "background", "section": "scene", "label": "Background", "type": "choice", "choices": [{"value": "transparent", "label": "Transparent (a film's is white)"}, {"value": "white", "label": "White (a motion's: the white studio)"}, {"value": "black", "label": "Black (a motion's: the dark studio)"}, {"value": "grey", "label": "Grey (a motion's: the dark studio)"}], "default": "transparent"},
        {"id": "colours", "section": "render", "label": "Colours", "type": "choice", "choices": [{"value": "neutral", "label": "True to the style (Khronos PBR Neutral)"}, {"value": "agx", "label": "Film-like (AgX)"}, {"value": "standard", "label": "Standard"}], "default": "neutral"},
        {"id": "key", "section": "scene", "label": "Key light, against the canvas's", "type": "number", "default": 1, "min": 0, "max": 10, "step": 0.1, "unit": "×"},
        {"id": "ambient", "section": "scene", "label": "Light all round, against the canvas's", "type": "number", "default": 1, "min": 0, "max": 10, "step": 0.1, "unit": "×"},
        {"id": "softness", "section": "scene", "label": "Shadows' softness", "type": "number", "default": 10, "min": 0, "max": 90, "step": 1, "unit": "°"},
        {"id": "quality", "section": "render", "when": {"id": "kind", "in": ["film"]}, "label": "A film's quality", "type": "choice", "choices": [{"value": "high", "label": "High"}, {"value": "medium", "label": "Medium: smaller"}, {"value": "lossless", "label": "Nearly lossless: largest"}], "default": "high"}
      ]
    }
  ]
}
