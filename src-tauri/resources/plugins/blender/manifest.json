{
  "id": "blender",
  "name": "Blender interface",
  "version": "0.2.0",
  "description": "Renders pictures and films of molecules in 3D with Blender 5.0 or later - installed separately, under its own licence; or, where none is found and you ask, Blender's official build fetched by Meno for its own use.",
  "licence": "GPL-3.0-or-later",
  "homepage": "https://www.blender.org",
  "environment": "uv",
  "installed": [
    {
      "name": "blender",
      "label": "Blender",
      "files": {"macos": "Blender", "windows": "blender.exe", "linux": "blender"},
      "places": {
        "macos": ["/Applications/Blender.app/Contents/MacOS", "{home}/Applications/Blender.app/Contents/MacOS"],
        "windows": ["{programs}/Blender Foundation/Blender *"]
      },
      "version": {"args": ["--version"], "after": "Blender ", "least": "5.0"}
    }
  ],
  "downloads": [
    {"file": "blender-5.2.2-macos-arm64.dmg", "name": "Blender 5.2.2 LTS", "licence": "GPL-3.0-or-later", "url": "https://download.blender.org/release/Blender5.2/blender-5.2.2-macos-arm64.dmg", "sha256": "dc4125399b8bfefe283cc1624d6cfc7809d1cac20ace51072127eb371f31f210", "bytes": 346286611, "system": "macos", "arch": "aarch64", "unpack": "dmg", "program": "Blender.app/Contents/MacOS/Blender", "installs": "blender"},
    {"file": "blender-5.2.2-windows-x64.zip", "name": "Blender 5.2.2 LTS", "licence": "GPL-3.0-or-later", "url": "https://download.blender.org/release/Blender5.2/blender-5.2.2-windows-x64.zip", "sha256": "3849d17a682cba006075aaa3f3597ecb5c9c30ec31035b2e092c53e40679b535", "bytes": 404453484, "system": "windows", "arch": "x86_64", "unpack": "zip", "program": "*/blender.exe", "installs": "blender"},
    {"file": "blender-5.2.2-windows-arm64.zip", "name": "Blender 5.2.2 LTS", "licence": "GPL-3.0-or-later", "url": "https://download.blender.org/release/Blender5.2/blender-5.2.2-windows-arm64.zip", "sha256": "2e90b53c9443cc56d2be75a61550a38e4aba942c8cded046ceff98ed58ebc67b", "bytes": 274036892, "system": "windows", "arch": "aarch64", "unpack": "zip", "program": "*/blender.exe", "installs": "blender"}
  ],
  "roles": [
    {
      "role": "render",
      "programs": ["blender"],
      "options": [
        {"id": "engine", "label": "Renderer", "type": "choice", "choices": [{"value": "cycles", "label": "Cycles: light traced, true shadows"}, {"value": "eevee", "label": "EEVEE: fast"}], "default": "cycles"},
        {"id": "samples", "label": "Samples for each pixel", "type": "number", "default": 128, "min": 1, "max": 4096, "step": 1},
        {"id": "denoise", "label": "Remove noise", "type": "switch", "default": true},
        {"id": "gpu", "label": "Use the graphics processor where Blender can", "type": "switch", "default": true},
        {"id": "background", "label": "Background", "type": "choice", "choices": [{"value": "transparent", "label": "Transparent (a film's is white)"}, {"value": "white", "label": "White"}, {"value": "black", "label": "Black"}, {"value": "grey", "label": "Grey"}], "default": "transparent"},
        {"id": "colours", "label": "Colours", "type": "choice", "choices": [{"value": "neutral", "label": "True to the style (Khronos PBR Neutral)"}, {"value": "agx", "label": "Film-like (AgX)"}, {"value": "standard", "label": "Standard"}], "default": "neutral"},
        {"id": "key", "label": "Key light, against the canvas's", "type": "number", "default": 1, "min": 0, "max": 10, "step": 0.1, "unit": "×"},
        {"id": "ambient", "label": "Light all round, against the canvas's", "type": "number", "default": 1, "min": 0, "max": 10, "step": 0.1, "unit": "×"},
        {"id": "softness", "label": "Shadows' softness", "type": "number", "default": 10, "min": 0, "max": 90, "step": 1, "unit": "°"},
        {"id": "quality", "label": "A film's quality", "type": "choice", "choices": [{"value": "high", "label": "High"}, {"value": "medium", "label": "Medium: smaller"}, {"value": "lossless", "label": "Nearly lossless: largest"}], "default": "high"}
      ]
    }
  ]
}
