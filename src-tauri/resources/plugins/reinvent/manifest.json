{
  "id": "reinvent",
  "name": "REINVENT 4",
  "version": "0.2.0",
  "uses": [{"name": "REINVENT", "version": "4.8.24+80a8d21"}],
  "description": "Makes new molecules with REINVENT 4, a generative model of SMILES: samples them from its prior trained on PubChem, each given as the SMILES it sampled, with its likelihood.",
  "licence": "Apache-2.0",
  "homepage": "https://github.com/MolecularAI/REINVENT4",
  "environment": "uv",
  "setUpBytes": 1000000000,
  "systems": ["macos", "windows"],
  "steps": [
    {
      "kinds": ["generate"],
      "options": [
        {"id": "count", "label": "How many (at most 100 in one run)", "type": "number", "default": 20, "min": 1, "max": 100, "step": 1},
        {"id": "seed", "label": "Random seed", "type": "number", "default": 1, "min": 0, "max": 2147483647, "step": 1}
      ]
    }
  ],
  "downloads": [
    {
      "file": "reinvent_pubchem.prior",
      "name": "REINVENT 4's prior trained on PubChem",
      "licence": "Apache-2.0",
      "url": "https://zenodo.org/api/records/20701824/files/reinvent_pubchem.prior/content",
      "sha256": "fe8cd1678452ad292a8f93e97cb19a85959b729e17113e157180d5e69ae89ef3",
      "bytes": 23528840
    }
  ]
}
