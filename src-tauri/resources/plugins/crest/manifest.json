{
  "id": "crest",
  "name": "CREST",
  "version": "2.12",
  "description": "Searches for a molecule's conformers in 3D, by metadynamics with the GFN methods of xtb, from the Grimme group.",
  "licence": "LGPL-3.0",
  "homepage": "https://crest-lab.github.io/crest-docs",
  "systems": ["macos", "linux"],
  "environment": "pixi",
  "steps": [
    {
      "kinds": ["conformers"],
      "takes": ["molecules", "conformers"],
      "programs": ["crest"],
      "options": [
        {"id": "method", "label": "Method", "type": "choice", "choices": [
          {"value": "gfn2", "label": "GFN2-xTB"},
          {"value": "gfn1", "label": "GFN1-xTB"},
          {"value": "gfnff", "label": "GFN-FF"},
          {"value": "gfn2//gfnff", "label": "GFN2-xTB//GFN-FF"}
        ], "default": "gfn2"},
        {"id": "solvent", "label": "Solvent (ALPB)", "type": "choice", "choices": [
          {"value": "none", "label": "None"},
          {"value": "acetone", "label": "Acetone"},
          {"value": "acetonitrile", "label": "Acetonitrile"},
          {"value": "aniline", "label": "Aniline"},
          {"value": "benzaldehyde", "label": "Benzaldehyde"},
          {"value": "benzene", "label": "Benzene"},
          {"value": "ch2cl2", "label": "Dichloromethane"},
          {"value": "chcl3", "label": "Chloroform"},
          {"value": "cs2", "label": "Carbon disulfide"},
          {"value": "dioxane", "label": "Dioxane"},
          {"value": "dmf", "label": "DMF"},
          {"value": "dmso", "label": "DMSO"},
          {"value": "ether", "label": "Diethyl ether"},
          {"value": "ethylacetate", "label": "Ethyl acetate"},
          {"value": "furane", "label": "Furan"},
          {"value": "hexadecane", "label": "Hexadecane"},
          {"value": "hexane", "label": "Hexane"},
          {"value": "methanol", "label": "Methanol"},
          {"value": "nitromethane", "label": "Nitromethane"},
          {"value": "octanol", "label": "Octanol"},
          {"value": "woctanol", "label": "Octanol, wet"},
          {"value": "phenol", "label": "Phenol"},
          {"value": "toluene", "label": "Toluene"},
          {"value": "thf", "label": "THF"},
          {"value": "water", "label": "Water"}
        ], "default": "none"},
        {"id": "search", "label": "Search", "type": "choice", "choices": [
          {"value": "full", "label": "Full"},
          {"value": "quick", "label": "Quick"},
          {"value": "squick", "label": "Quicker"},
          {"value": "mquick", "label": "Quickest"}
        ], "default": "full"},
        {"id": "ewin", "label": "Energy window", "type": "number", "default": 6, "min": 0.1, "max": 100, "step": 0.5, "unit": "kcal/mol"}
      ]
    },
    {
      "kinds": ["optimise"],
      "programs": ["crest"],
      "options": [
        {"id": "method", "label": "Method", "type": "choice", "choices": [{"value": "gfn2", "label": "GFN2-xTB"}, {"value": "gfn1", "label": "GFN1-xTB"}, {"value": "gfnff", "label": "GFN-FF"}], "default": "gfn2"},
        {"id": "solvent", "label": "Solvent (ALPB)", "type": "choice", "choices": [
          {"value": "none", "label": "None"},
          {"value": "acetone", "label": "Acetone"},
          {"value": "acetonitrile", "label": "Acetonitrile"},
          {"value": "aniline", "label": "Aniline"},
          {"value": "benzaldehyde", "label": "Benzaldehyde"},
          {"value": "benzene", "label": "Benzene"},
          {"value": "ch2cl2", "label": "Dichloromethane"},
          {"value": "chcl3", "label": "Chloroform"},
          {"value": "cs2", "label": "Carbon disulfide"},
          {"value": "dioxane", "label": "Dioxane"},
          {"value": "dmf", "label": "DMF"},
          {"value": "dmso", "label": "DMSO"},
          {"value": "ether", "label": "Diethyl ether"},
          {"value": "ethylacetate", "label": "Ethyl acetate"},
          {"value": "furane", "label": "Furan"},
          {"value": "hexadecane", "label": "Hexadecane"},
          {"value": "hexane", "label": "Hexane"},
          {"value": "methanol", "label": "Methanol"},
          {"value": "nitromethane", "label": "Nitromethane"},
          {"value": "octanol", "label": "Octanol"},
          {"value": "woctanol", "label": "Octanol, wet"},
          {"value": "phenol", "label": "Phenol"},
          {"value": "toluene", "label": "Toluene"},
          {"value": "thf", "label": "THF"},
          {"value": "water", "label": "Water"}
        ], "default": "none"}
      ]
    }
  ]
}
