{
  "id": "xtb",
  "name": "xTB",
  "version": "0.1.6",
  "uses": [{"name": "xtb", "version": "6.7.1"}],
  "description": "Optimises molecules in 3D, and works out their energies and vibrations, with the semiempirical GFN methods of the Grimme group; reads xtb's outputs.",
  "licence": "LGPL-3.0-or-later",
  "homepage": "https://xtb-docs.readthedocs.io",
  "environment": "pixi",
  "kinds": [
    {"id": "xtb", "name": "xTB output", "program": "xTB", "writtenBy": "xtb", "extensions": [".out", ".log"], "marks": [{"text": "| x T B |"}, {"text": "* xtb version", "at": "line-start"}], "grammar": {"file": "xtb-output.grammar", "tones": {"WarningLine": "warning", "ErrorLine": "error", "Landmark": "landmark", "Success": "success", "Rule": "comment", "Word": "value"}}},
    {"id": "xtb-g98", "name": "xTB frequencies, Gaussian form", "program": "xTB", "writtenBy": "xtb", "extensions": [".out"], "marks": [{"text": "frequency output generated by the xtb code"}]}
  ],
  "reads": ["xtb", "xtb-g98"],
  "xyzEnergies": [{"id": "xtb", "pattern": "(?:^|\\s)energy:\\s*(-?\\d+\\.\\d+(?:[eE][-+]?\\d+)?)", "unit": "hartree"}],
  "xyzSteps": [{"id": "xtb-opt", "file": "xtbopt.log", "comment": "^\\s*energy:\\s*-?\\d+\\.\\d+\\s+gnorm:"}],
  "steps": [
    {
      "kinds": ["optimise"],
      "programs": ["xtb"],
      "options": [
        {"id": "method", "label": "Method", "type": "choice", "choices": [{"value": "gfn2", "label": "GFN2-xTB"}, {"value": "gfn1", "label": "GFN1-xTB"}, {"value": "gfnff", "label": "GFN-FF"}], "default": "gfn2"},
        {"id": "solvent", "label": "Solvent (ALPB)", "type": "choice", "choices": [
          {"value": "none", "label": "None"},
          {"value": "acetone", "label": "Acetone"},
          {"value": "acetonitrile", "label": "Acetonitrile"},
          {"value": "aniline", "label": "Aniline"},
          {"value": "benzaldehyde", "label": "Benzaldehyde"},
          {"value": "benzene", "label": "Benzene"},
          {"value": "ch2cl2", "label": "Dichloromethane"},
          {"value": "chcl3", "label": "Chloroform"},
          {"value": "cs2", "label": "Carbon disulfide"},
          {"value": "dioxane", "label": "Dioxane"},
          {"value": "dmf", "label": "DMF"},
          {"value": "dmso", "label": "DMSO"},
          {"value": "ether", "label": "Diethyl ether"},
          {"value": "ethylacetate", "label": "Ethyl acetate"},
          {"value": "furane", "label": "Furan"},
          {"value": "hexadecane", "label": "Hexadecane"},
          {"value": "hexane", "label": "Hexane"},
          {"value": "methanol", "label": "Methanol"},
          {"value": "nitromethane", "label": "Nitromethane"},
          {"value": "octanol", "label": "Octanol"},
          {"value": "woctanol", "label": "Octanol, wet"},
          {"value": "phenol", "label": "Phenol"},
          {"value": "toluene", "label": "Toluene"},
          {"value": "thf", "label": "THF"},
          {"value": "water", "label": "Water"}
        ], "default": "none"},
        {"id": "level", "label": "Converged to", "type": "choice", "choices": [
          {"value": "crude", "label": "Crude"},
          {"value": "sloppy", "label": "Sloppy"},
          {"value": "loose", "label": "Loose"},
          {"value": "lax", "label": "Lax"},
          {"value": "normal", "label": "Normal"},
          {"value": "tight", "label": "Tight"},
          {"value": "vtight", "label": "Very tight"},
          {"value": "extreme", "label": "Extreme"}
        ], "default": "normal"}
      ]
    },
    {
      "kinds": ["energy", "frequencies"],
      "programs": ["xtb"],
      "options": [
        {"id": "method", "label": "Method", "type": "choice", "choices": [{"value": "gfn2", "label": "GFN2-xTB"}, {"value": "gfn1", "label": "GFN1-xTB"}, {"value": "gfnff", "label": "GFN-FF"}], "default": "gfn2"},
        {"id": "solvent", "label": "Solvent (ALPB)", "type": "choice", "choices": [
          {"value": "none", "label": "None"},
          {"value": "acetone", "label": "Acetone"},
          {"value": "acetonitrile", "label": "Acetonitrile"},
          {"value": "aniline", "label": "Aniline"},
          {"value": "benzaldehyde", "label": "Benzaldehyde"},
          {"value": "benzene", "label": "Benzene"},
          {"value": "ch2cl2", "label": "Dichloromethane"},
          {"value": "chcl3", "label": "Chloroform"},
          {"value": "cs2", "label": "Carbon disulfide"},
          {"value": "dioxane", "label": "Dioxane"},
          {"value": "dmf", "label": "DMF"},
          {"value": "dmso", "label": "DMSO"},
          {"value": "ether", "label": "Diethyl ether"},
          {"value": "ethylacetate", "label": "Ethyl acetate"},
          {"value": "furane", "label": "Furan"},
          {"value": "hexadecane", "label": "Hexadecane"},
          {"value": "hexane", "label": "Hexane"},
          {"value": "methanol", "label": "Methanol"},
          {"value": "nitromethane", "label": "Nitromethane"},
          {"value": "octanol", "label": "Octanol"},
          {"value": "woctanol", "label": "Octanol, wet"},
          {"value": "phenol", "label": "Phenol"},
          {"value": "toluene", "label": "Toluene"},
          {"value": "thf", "label": "THF"},
          {"value": "water", "label": "Water"}
        ], "default": "none"}
      ]
    }
  ]
}
