{
  "id": "gaussian",
  "name": "Gaussian interface",
  "version": "0.2.0",
  "description": "Optimises molecules in 3D and works out their energies and vibrations with Gaussian 16 - installed separately, under its own licence, never downloaded by Meno - and writes a molecule in 3D as Gaussian 16 input.",
  "licence": "Apache-2.0",
  "homepage": "https://gaussian.com",
  "environment": "uv",
  "kinds": [
    {"id": "gaussian-input", "name": "Gaussian input", "extensions": [".gjf", ".com"], "grammar": {"file": "gaussian-input.grammar", "tones": {"Link0Name": "keyword", "RouteStart": "keyword", "RouteWord": "keyword", "Link1": "keyword", "Number": "number", "Element": "tag", "Value": "value", "Comment": "comment"}}}
  ],
  "writes": [
    {
      "kind": "gaussian-input",
      "options": [
        {"id": "job", "label": "Job", "type": "choice", "choices": [
          {"value": "opt freq", "label": "Optimisation, then frequencies (Opt Freq)"},
          {"value": "opt", "label": "Optimisation (Opt)"},
          {"value": "freq", "label": "Frequencies (Freq)"},
          {"value": "sp", "label": "Single-point energy (SP)"}
        ], "default": "opt freq"},
        {"id": "method", "label": "Method", "type": "text", "default": "B3LYP"},
        {"id": "basis", "label": "Basis set", "type": "text", "default": "6-31G(d)"},
        {"id": "dispersion", "label": "Empirical dispersion", "type": "choice", "choices": [
          {"value": "none", "label": "None"},
          {"value": "GD2", "label": "Grimme's D2 (GD2)"},
          {"value": "GD3", "label": "Grimme's D3 (GD3)"},
          {"value": "GD3BJ", "label": "Grimme's D3 with Becke-Johnson damping (GD3BJ)"}
        ], "default": "GD3BJ"},
        {"id": "keywords", "label": "More keywords for the route section", "type": "text", "default": ""},
        {"id": "charge", "label": "Charge", "type": "number", "default": 0, "step": 1, "from": "charge"},
        {"id": "multiplicity", "label": "Spin multiplicity", "type": "number", "default": 1, "min": 1, "step": 1, "from": "multiplicity"},
        {"id": "title", "label": "Title", "type": "text", "default": "", "from": "name"},
        {"id": "checkpoint", "label": "A checkpoint file named after the input (%Chk)", "type": "switch", "default": true},
        {"id": "processors", "label": "Processors (%NProcShared; 0 leaves it to Gaussian)", "type": "number", "default": 0, "min": 0, "step": 1},
        {"id": "memory", "label": "Memory (%Mem, as 8GB; empty leaves it to Gaussian)", "type": "text", "default": ""}
      ]
    }
  ],
  "installed": [
    {"name": "g16", "label": "Gaussian 16", "files": {"macos": "g16", "linux": "g16"}, "path": ["{folder}"], "env": {"g16root": "{parent}", "GAUSS_EXEDIR": "{folder}"}}
  ],
  "steps": [
    {
      "kinds": ["optimise", "energy", "frequencies"],
      "programs": ["g16"],
      "options": [
        {"id": "method", "label": "Method", "type": "text", "default": "B3LYP"},
        {"id": "basis", "label": "Basis set", "type": "text", "default": "6-31G(d)"},
        {"id": "dispersion", "label": "Empirical dispersion", "type": "choice", "choices": [
          {"value": "none", "label": "None"},
          {"value": "GD2", "label": "Grimme's D2 (GD2)"},
          {"value": "GD3", "label": "Grimme's D3 (GD3)"},
          {"value": "GD3BJ", "label": "Grimme's D3 with Becke-Johnson damping (GD3BJ)"}
        ], "default": "GD3BJ"},
        {"id": "solvation", "label": "Solvation", "type": "choice", "choices": [{"value": "none", "label": "None"}, {"value": "PCM", "label": "PCM"}, {"value": "SMD", "label": "SMD"}], "default": "none"},
        {"id": "solvent", "label": "Solvent", "type": "choice", "choices": [
          {"value": "Water", "label": "Water"},
          {"value": "Acetonitrile", "label": "Acetonitrile"},
          {"value": "Acetone", "label": "Acetone"},
          {"value": "Benzene", "label": "Benzene"},
          {"value": "Chloroform", "label": "Chloroform"},
          {"value": "Dichloromethane", "label": "Dichloromethane"},
          {"value": "n,n-DiMethylFormamide", "label": "DMF"},
          {"value": "DiMethylSulfoxide", "label": "DMSO"},
          {"value": "DiethylEther", "label": "Diethyl ether"},
          {"value": "Ethanol", "label": "Ethanol"},
          {"value": "EthylEthanoate", "label": "Ethyl acetate"},
          {"value": "n-Hexane", "label": "Hexane"},
          {"value": "Methanol", "label": "Methanol"},
          {"value": "TetraHydroFuran", "label": "THF"},
          {"value": "Toluene", "label": "Toluene"},
          {"value": "1,4-Dioxane", "label": "1,4-Dioxane"},
          {"value": "CarbonTetraChloride", "label": "Carbon tetrachloride"},
          {"value": "Pyridine", "label": "Pyridine"},
          {"value": "NitroMethane", "label": "Nitromethane"},
          {"value": "CycloHexane", "label": "Cyclohexane"},
          {"value": "n-Octanol", "label": "1-Octanol"},
          {"value": "2-Propanol", "label": "2-Propanol"}
        ], "default": "Water"},
        {"id": "keywords", "label": "More keywords for the route section", "type": "text", "default": ""},
        {"id": "memory", "label": "Memory (%Mem, as 8GB; empty leaves it to Gaussian)", "type": "text", "default": ""}
      ]
    }
  ]
}
