{
  "id": "rdkit",
  "name": "RDKit",
  "version": "0.1.15",
  "uses": [{"name": "RDKit", "version": "2026.03.6"}],
  "description": "Makes sense of a structure as it is drawn - its hydrogens, valence, aromatic rings, and R and S, E and Z - reads and writes SMILES, and makes structures in 3D and their conformers.",
  "licence": "BSD-3-Clause",
  "homepage": "https://www.rdkit.org",
  "environment": "uv",
  "roles": [
    {"role": "smiles"},
    {"role": "checks"},
    {"role": "stereoisomers"},
    {"role": "configurations"},
    {
      "role": "conformers",
      "options": [
        {"id": "sought", "label": "Conformers sought", "type": "choice", "choices": [{"value": "needed", "label": "As many as the molecule needs"}, {"value": "fixed", "label": "This many"}], "default": "needed"},
        {"id": "count", "when": {"id": "sought", "in": ["fixed"]}, "label": "How many", "type": "number", "default": 200, "min": 1, "max": 500, "step": 1},
        {"id": "field", "label": "Force field", "type": "choice", "choices": [{"value": "MMFF94", "label": "MMFF94"}, {"value": "MMFF94s", "label": "MMFF94s"}, {"value": "UFF", "label": "UFF"}], "default": "MMFF94"},
        {"id": "iters", "label": "Optimisation steps, at most", "type": "number", "default": 2000, "min": 10, "max": 100000, "step": 10},
        {"id": "seed", "label": "Random seed", "type": "number", "default": 19781, "min": 0, "max": 2147483647, "step": 1}
      ]
    },
    {"role": "drawing"}
  ],
  "steps": [
    {"kinds": ["conformers"], "programs": ["python"]},
    {
      "kinds": ["minimise"],
      "programs": ["python"],
      "options": [
        {"id": "field", "label": "Force field", "type": "choice", "choices": [{"value": "MMFF94", "label": "MMFF94"}, {"value": "MMFF94s", "label": "MMFF94s"}, {"value": "UFF", "label": "UFF"}], "default": "MMFF94"},
        {"id": "steps", "label": "Steps at most", "type": "number", "default": 2000, "min": 1, "max": 100000},
        {"id": "start", "label": "Start from", "type": "choice", "choices": [{"value": "as-it-comes", "label": "Where it is"}, {"value": "first", "label": "Where its restraints were first held"}], "default": "as-it-comes"}
      ]
    },
    {
      "kinds": ["duplicates"],
      "options": [
        {"id": "mirrors", "label": "Mirror images", "type": "choice", "choices": [{"value": "apart", "label": "Kept apart"}, {"value": "counted", "label": "Counted in (degeneracy 2)"}], "default": "apart"}
      ]
    },
    {
      "kinds": ["check-structures"],
      "options": [
        {"id": "parts", "label": "More than one part (a salt, a mixture)", "type": "choice", "choices": [{"value": "aside", "label": "Set aside"}, {"value": "keep", "label": "Keep"}], "default": "aside"},
        {"id": "valence", "label": "An atom with more bonds than it can have", "type": "choice", "choices": [{"value": "aside", "label": "Set aside"}, {"value": "keep", "label": "Keep as drawn"}], "default": "aside"},
        {"id": "electrons", "label": "A part with no electrons (H+)", "type": "choice", "choices": [{"value": "aside", "label": "Set aside"}, {"value": "keep", "label": "Keep"}], "default": "aside"},
        {"id": "radicals", "label": "Radicals", "type": "choice", "choices": [{"value": "aside", "label": "Set aside"}, {"value": "keep", "label": "Keep"}], "default": "aside"}
      ]
    },
    {
      "kinds": ["stereoisomers"],
      "options": [
        {"id": "open", "label": "Stereo left open", "type": "choice", "choices": [{"value": "every", "label": "Every stereoisomer"}, {"value": "aside", "label": "Set aside"}], "default": "every"}
      ]
    },
    {
      "kinds": ["descriptors"]
    }
  ]
}
