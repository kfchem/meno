# The cclib plugin's environment: cclib, which reads many calculation
# programs' output, for its worker (worker.py). Set up only when the plugin
# is added (docs/PLUGINS.md).
# Locked for every platform, with hashes, by:
#   uv pip compile --universal --python-version 3.12 --generate-hashes requirements.in -o requirements.lock
# 1.9rc1, cclib's release candidate, the version this plugin's mapping is
# tested with. On PyPI, so pinned by its hash as everything else is.
cclib==1.9rc1
