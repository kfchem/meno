{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": [
      "resources/py/*.lock",
      "resources/workers/**/*",
      "resources/plugins/*/manifest.json",
      "resources/plugins/*/*.py",
      "resources/plugins/*/*.lock",
      "resources/plugins/*/pixi.toml",
      "resources/plugins/*/LICENSE",
      "resources/licenses/*",
      "pdfium/windows/pdfium.dll"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/ole.wxs"],
        "componentRefs": ["MenoOleClass", "MenoOleClass32"]
      }
    }
  }
}
