{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": [
      "resources/py/*.lock",
      "resources/plugins/*/manifest.json",
      "resources/plugins/*/*.py",
      "resources/plugins/*/*.lock",
      "resources/plugins/*/pixi.toml",
      "resources/plugins/*/LICENSE",
      "resources/licenses/*",
      "pdfium/windows/pdfium.dll",
      "icons/document/meno-document.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["meno"],
        "name": "Meno.Workspace",
        "description": "Meno workspace",
        "role": "Editor",
        "mimeType": "application/vnd.kfchem.meno+zip"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/ole.wxs"],
        "componentRefs": ["MenoOleClass", "MenoOleClass32"]
      }
    }
  }
}
