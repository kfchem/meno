{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "appDirectoriesOverride": {
      "localData": "$LOCALDATA/Meno/data",
      "cache": "$LOCALDATA/Meno/data"
    }
  },
  "bundle": {
    "resources": [
      "resources/licenses/*",
      "pdfium/windows/pdfium.dll",
      "icons/document/meno-document.ico",
      "icons/formats/*.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["meno"],
        "name": "Meno.Workspace",
        "description": "Meno workspace",
        "role": "Editor",
        "mimeType": "application/vnd.kfchem.meno+zip"
      }
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "fragmentPaths": ["windows/ole.wxs"],
        "componentRefs": ["MenoOleClass", "MenoOleClass32"]
      }
    }
  }
}
