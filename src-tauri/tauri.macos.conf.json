{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "Meno",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 22
        }
      }
    ]
  },
  "bundle": {
    "resources": [
      "resources/plugins/*/manifest.json",
      "resources/plugins/*/*.py",
      "resources/plugins/*/*.lock",
      "resources/plugins/*/pixi.toml",
      "resources/plugins/*/LICENSE",
      "resources/licenses/*"
    ],
    "macOS": {
      "frameworks": [
        "pdfium/macos/libpdfium.dylib"
      ],
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/meno-document.icns": "icons/document/meno-document.icns",
        "Resources/meno-pdf.icns": "icons/formats/pdf.icns",
        "Resources/meno-mol.icns": "icons/formats/mol.icns",
        "Resources/meno-sdf.icns": "icons/formats/sdf.icns",
        "Resources/meno-rxn.icns": "icons/formats/rxn.icns",
        "Resources/meno-xyz.icns": "icons/formats/xyz.icns",
        "Resources/meno-pdb.icns": "icons/formats/pdb.icns",
        "Resources/meno-cube.icns": "icons/formats/cube.icns"
      }
    }
  }
}
