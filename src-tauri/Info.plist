<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged by Tauri into the app's own Info.plist (macOS). Meno is the app for
  its workspace files, .meno (docs/FILE-IO.md, *Opening a workspace file from
  the system*): it declares their type - its own, so exported - and opens
  them as their owner, with their own icon (icons/document, put in the app's
  Resources by tauri.macos.conf.json). The type conforms to public.data and
  public.content, not to public.zip-archive, though the file is a zip: a
  workspace is a document, not an archive to unpack - and a browser that
  opens "safe" downloads would unpack one that said it was an archive.

  Meno is also offered in the Finder's Open With for the files it reads -
  structures and PDFs (src/opened.rs, OPENED_WITH) - as an Alternate: a
  secondary viewer, never chosen to open them unless asked, so whatever
  opens them still does. PDF by the system's type, com.adobe.pdf. The
  structure files by their extensions (CFBundleTypeExtensions), declaring
  no type of Meno's own: where another app declares a type for one, the
  system takes its, and a claim on a type of Meno's would not be found.
  Each format is a type of its own here, with its own icon (icons/formats,
  put in the app's Resources by tauri.macos.conf.json): where Meno is made
  the app that opens it (Settings, Files - src/defaults.rs), the Finder
  shows the format's icon rather than Meno's own.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Meno workspace</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>dev.kfchem.meno.workspace</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>meno-document.icns</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>MDL Molfile</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>mol</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>meno-mol.icns</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>SD file</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>sdf</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>meno-sdf.icns</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>MDL reaction file</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>rxn</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>meno-rxn.icns</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>XYZ file</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>xyz</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>meno-xyz.icns</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PDB file</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>pdb</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>meno-pdb.icns</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Gaussian cube file</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>cube</string>
        <string>cub</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>meno-cube.icns</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PDF document</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.adobe.pdf</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>meno-pdf.icns</string>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>dev.kfchem.meno.workspace</string>
      <key>UTTypeDescription</key>
      <string>Meno workspace</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.content</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>meno-document.icns</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>meno</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/vnd.kfchem.meno+zip</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
